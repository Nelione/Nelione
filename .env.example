# ==============================================================================
# NELIONE — Variables de entorno
# ==============================================================================
# Copia este archivo a .env.local para desarrollo local.
# En Vercel, configura estas variables en Project Settings → Environment Variables.
# NUNCA subas .env.local al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# Sitio
# ------------------------------------------------------------------------------
# URL canónica. En desarrollo: http://localhost:3000
# En producción: https://nelione.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase
# Obtén estos valores en: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ⚠️ SECRETO — Service Role Key. Bypassa RLS. Solo se usa en servidor
# (webhook de Stripe y acciones de administración). Jamás con prefijo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ------------------------------------------------------------------------------
# Stripe
# Obtén estos valores en: Stripe Dashboard → Developers → API keys
# Usa las claves de test (sk_test_/pk_test_) hasta el lanzamiento.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secreto del webhook. Se genera al crear el endpoint en
# Stripe Dashboard → Developers → Webhooks → Add endpoint
#   URL: https://nelione.com/api/webhooks/stripe
#   Eventos: checkout.session.completed, checkout.session.expired
# Para desarrollo local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
